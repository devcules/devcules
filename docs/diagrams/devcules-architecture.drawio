    <diagram id="arch13" name="Arch_13">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1750" pageHeight="1420" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t14" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#333333" value="&lt;b&gt;ARCH_13&lt;/b&gt; — Build 13 (M2.3): the model router and the Meta provider. Agents call /llm/{provider} with a per-launch token, never a provider key; each request is redacted, the real key is added from the vault, and the reply comes back restored, streamed or not." vertex="1">
                    <mxGeometry height="60" width="1090" x="40" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="legend14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;• blue = shipped in this build (M2.3)&lt;br&gt;• grey dashed = planned module (milestone tag)&lt;br&gt;• dashed + animated = a model call on its way out or back (plays in the draw.io app)&lt;br&gt;• red = a refusal, or a known limit" vertex="1">
                    <mxGeometry height="94" width="570" x="1140" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="a13-z1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;1 · LAUNCH TOKENS&lt;/b&gt; — internal/launch, the only credential an agent holds" vertex="1">
                    <mxGeometry height="330" width="820" x="40" y="118" as="geometry"/>
                </mxCell>
                <mxCell id="a13-1.1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;dvl_ + 32 random bytes&lt;/b&gt;&lt;br&gt;base64url · shown once&lt;br&gt;only SHA-256 is stored" vertex="1">
                    <mxGeometry height="86" width="260" x="70" y="186" as="geometry"/>
                </mxCell>
                <mxCell id="a13-1.2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;lifetime&lt;/b&gt;&lt;br&gt;12 h default · 7 days max&lt;br&gt;revocable · optional provider" vertex="1">
                    <mxGeometry height="86" width="240" x="350" y="186" as="geometry"/>
                </mxCell>
                <mxCell id="a13-1.3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;LaunchTokens repo&lt;/b&gt;&lt;br&gt;migration 0005 · storetest&lt;br&gt;last-used touched once a minute" vertex="1">
