                    <mxGeometry height="470" width="1090" x="40" y="484" as="geometry"/>
                </mxCell>
                <mxCell id="a9-f1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;serve → runner&lt;/b&gt;&lt;br&gt;term.open · attach · input · resize&lt;br&gt;detach · close · list" vertex="1">
                    <mxGeometry height="86" width="240" x="70" y="552" as="geometry"/>
                </mxCell>
                <mxCell id="a9-f2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;runner → serve&lt;/b&gt;&lt;br&gt;term.ok / error (same id)&lt;br&gt;output · exit · listed" vertex="1">
                    <mxGeometry height="86" width="250" x="340" y="552" as="geometry"/>
                </mxCell>
                <mxCell id="a9-f3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;ids&lt;/b&gt;&lt;br&gt;16 hex chars minted by serve&lt;br&gt;checked on both ends · dvc-&amp;lt;id&amp;gt;" vertex="1">
                    <mxGeometry height="86" width="240" x="620" y="552" as="geometry"/>
                </mxCell>
                <mxCell id="a9-f4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;limits&lt;/b&gt;&lt;br&gt;16 terminals · cols/rows 1–500&lt;br&gt;input ≤ 64 KiB per frame" vertex="1">
                    <mxGeometry height="86" width="220" x="890" y="552" as="geometry"/>
                </mxCell>
                <mxCell id="a9-f5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;input is one-way&lt;/b&gt;&lt;br&gt;only a failure answers; it is&lt;br&gt;the busiest frame" vertex="1">
                    <mxGeometry height="86" width="240" x="70" y="664" as="geometry"/>
                </mxCell>
                <mxCell id="a9-f6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;output batches&lt;/b&gt;&lt;br&gt;32 KiB or 10 ms, whichever first&lt;br&gt;base64 inside the JSON frame" vertex="1">
                    <mxGeometry height="86" width="250" x="340" y="664" as="geometry"/>
                </mxCell>
                <mxCell id="a9-f7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;replies by frame id&lt;/b&gt;&lt;br&gt;the relay waits ≤ 5 s → 504&lt;br&gt;late replies are dropped" vertex="1">
                    <mxGeometry height="86" width="240" x="620" y="664" as="geometry"/>
                </mxCell>
                <mxCell id="a9-f8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;never logged&lt;/b&gt;&lt;br&gt;terminal bytes can hold secrets&lt;br&gt;reasons are fixed strings" vertex="1">
                    <mxGeometry height="86" width="220" x="890" y="664" as="geometry"/>
                </mxCell>
                <mxCell id="a9-f9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;the link’s read loops never wait&lt;/b&gt; — a runner mid-write cannot answer a ping, so any blocking write from a read loop stalls both ends until the heartbeat cuts the link" vertex="1">
                    <mxGeometry height="66" width="1040" x="70" y="780" as="geometry"/>
                </mxCell>
                <mxCell id="a9-f10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;resume model&lt;/b&gt; — no replay buffer of ours: a new attach makes tmux redraw the screen; tmux sessions die with the runner container" vertex="1">
                    <mxGeometry height="66" width="1040" x="70" y="864" as="geometry"/>
                </mxCell>
                <mxCell id="a9-q9" edge="1" parent="1" source="a9-f1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0066CC;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;flowAnimation=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" target="a9-f2" value="answers">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a9-q10" edge="1" parent="1" source="a9-f2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#999999;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" target="a9-f3" value="">
                    <mxGeometry relative="1" as="geometry"/>
