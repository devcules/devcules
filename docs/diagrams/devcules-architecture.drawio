                <mxCell id="a7-z-not" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;5 · NOT IN THIS BUILD&lt;/b&gt; — stated plainly so nothing above reads as more than it is" vertex="1">
