                <mxCell id="a12-2.5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;defaults&lt;/b&gt;&lt;br&gt;SECRET mask · personal data off&lt;br&gt;PII scanning is opt-in" vertex="1">
