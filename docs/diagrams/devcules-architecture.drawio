    </diagram>
    <diagram id="arch19" name="Arch_19">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1750" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t20" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#333333" value="&lt;b&gt;ARCH_19&lt;/b&gt; — Projects as the home of terminals: the desktop sidebar lists each project with its own terminals; a project is a folder or repo picked in a folder browser on its runner or machine; a new terminal asks what runs in it and, for an agent, which provider it calls and with which model." vertex="1"><mxGeometry x="40" y="30" width="1090" height="80" as="geometry"/></mxCell>
                <mxCell id="legend20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;• blue = shipped in this build&lt;br&gt;• arrows = calls, browser → serve → runner/machine → provider" vertex="1"><mxGeometry x="1140" y="20" width="440" height="80" as="geometry"/></mxCell>
                <mxCell id="ui20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;web&lt;/b&gt;&lt;br&gt;Sidebar: Projects (+ Project) → project (⎇ repo / ▢ folder, count, +, ✕) → its terminals (name · agent · id); fold state per browser&lt;br&gt;DirPicker: up · ~ · workspace · typed path · hidden toggle; tap selects, → opens; git badge&lt;br&gt;NewTerminal: name · Runs (Shell | installed agent) · Provider (keyless off) · Model (list or typed)" vertex="1"><mxGeometry x="40" y="130" width="1000" height="110" as="geometry"/></mxCell>
                <mxCell id="serve20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacing=10" value="&lt;b&gt;devcules serve&lt;/b&gt;" vertex="1"><mxGeometry x="40" y="270" width="1000" height="380" as="geometry"/></mxCell>
                <mxCell id="api20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;internal/api&lt;/b&gt;&lt;br&gt;GET /api/browse?runner=|machine=&amp;amp;path=&lt;br&gt;POST /api/terminals · /api/projects/{id}/terminals {name}&lt;br&gt;POST /api/agents {agent, provider, model, project, name}: speaks it (400) · served + keyed (409) · model required off its own provider&lt;br&gt;GET /api/providers → [{id, ready}] · GET /api/providers/{id}/models" vertex="1"><mxGeometry x="60" y="310" width="560" height="140" as="geometry"/></mxCell>
                <mxCell id="router20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;internal/router&lt;/b&gt;&lt;br&gt;Ready: key in the vault?&lt;br&gt;Models: provider GET v1/models with the vault key, has_more/after_id paging, 5-minute cache&lt;br&gt;/llm/{p}: launch token minted for the chosen provider (Allows)" vertex="1"><mxGeometry x="660" y="310" width="360" height="140" as="geometry"/></mxCell>
                <mxCell id="store20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;store&lt;/b&gt;&lt;br&gt;projects (+ 0010 git flag)" vertex="1"><mxGeometry x="60" y="480" width="260" height="60" as="geometry"/></mxCell>
                <mxCell id="relay20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;terminals/relay&lt;/b&gt;&lt;br&gt;term.browse → term.browsed&lt;br&gt;term.open {dir, project, name, agent: {provider}}" vertex="1"><mxGeometry x="360" y="480" width="330" height="80" as="geometry"/></mxCell>
                <mxCell id="agents20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;plugins/agents&lt;/b&gt; Providers(), own first&lt;br&gt;Muse Code: meta · Claude Code: anthropic, meta (/llm/&amp;lt;p&amp;gt;) · Codex: openai, meta (/llm/&amp;lt;p&amp;gt;/v1)&lt;br&gt;ProviderFor refuses any other" vertex="1"><mxGeometry x="40" y="690" width="640" height="80" as="geometry"/></mxCell>
                <mxCell id="runner20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;runner / machine&lt;/b&gt;&lt;br&gt;Browse: subfolders, .git marked, max 500&lt;br&gt;tmux tags @devcules_project · @devcules_name" vertex="1"><mxGeometry x="720" y="690" width="320" height="80" as="geometry"/></mxCell>
                <mxCell id="meta20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;Meta Model API&lt;/b&gt;&lt;br&gt;v1/messages (Anthropic-style) · v1/responses · v1/models" vertex="1"><mxGeometry x="1080" y="310" width="300" height="80" as="geometry"/></mxCell>
                <mxCell id="e20a" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6C8EBF;endArrow=block" value="HTTPS, session" edge="1" source="ui20" target="api20"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e20b" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6C8EBF;endArrow=block" value="" edge="1" source="api20" target="router20"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e20c" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6C8EBF;endArrow=block" value="" edge="1" source="api20" target="relay20"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e20d" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6C8EBF;endArrow=block" value="link" edge="1" source="relay20" target="runner20"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e20e" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6C8EBF;endArrow=block" value="vault key" edge="1" source="router20" target="meta20"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e20f" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6C8EBF;endArrow=block" value="launch" edge="1" source="runner20" target="agents20"><mxGeometry relative="1" as="geometry"/></mxCell>
            <mxCell id="keys20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;Settings → Providers&lt;/b&gt;&lt;br&gt;PUT / DELETE /api/providers/{id}/key → vault provider/{id}/api_key (never read back) · audit provider.key.set/remove · drops the model cache · applies with no restart" vertex="1"><mxGeometry x="1080" y="420" width="300" height="110" as="geometry"/></mxCell>
                <mxCell id="e20g" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6C8EBF;endArrow=block" value="" edge="1" source="keys20" target="router20"><mxGeometry relative="1" as="geometry"/></mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="arch20" name="Arch_20">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1750" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t21" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#333333" value="&lt;b&gt;ARCH_20&lt;/b&gt; — Model provider profiles: each provider is a saved profile (name, OpenAI-compatible or Anthropic format, base URL, default model) the router resolves on every call; its key stays in the vault. Agents get every profile that serves the API they speak." vertex="1"><mxGeometry x="40" y="20" width="1060" height="60" as="geometry"/></mxCell>
                <mxCell id="legend21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;• blue = shipped in this build&lt;br&gt;• arrows = calls, browser → serve → provider" vertex="1"><mxGeometry x="1140" y="20" width="440" height="80" as="geometry"/></mxCell>
                <mxCell id="ui21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;web · Settings → Providers&lt;/b&gt;&lt;br&gt;cards: name · format chip · key set · base URL · default model · Make default · Edit · ✕&lt;br&gt;form: presets (Meta, Anthropic, OpenAI, OpenAI-compatible) · name · format · base URL · Authentication (API key) · API for agents (auto · chat · responses) · API key (write-only) · model + Load models · use as default&lt;br&gt;New terminal: profiles by name, format chip, key state" vertex="1"><mxGeometry x="40" y="110" width="1000" height="120" as="geometry"/></mxCell>
                <mxCell id="serve21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacing=10" value="&lt;b&gt;devcules serve&lt;/b&gt;" vertex="1"><mxGeometry x="40" y="260" width="1000" height="420" as="geometry"/></mxCell>
                <mxCell id="api21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;internal/api&lt;/b&gt;&lt;br&gt;GET · POST /api/providers · PUT · DELETE /api/providers/{id} (not the default, not the last)&lt;br&gt;PUT /api/providers/{id}/default · GET {id}/models · PUT/DELETE {id}/key&lt;br&gt;POST /api/providers/probe {format, baseUrl, key | id}: 10 s, saved key only on its saved host&lt;br&gt;a base URL moved to another host needs the key again · CSRF · audit provider.add/edit/remove/default (no keys)" vertex="1"><mxGeometry x="60" y="300" width="960" height="100" as="geometry"/></mxCell>
                <mxCell id="prov21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;internal/providers&lt;/b&gt;&lt;br&gt;Service: List · Add (id from name) · Edit · SetDefault · Remove · Seed once · Pin from DEVCULES_*_BASE_URL&lt;br&gt;Catalog for the router (cached, reloaded on every write)&lt;br&gt;Check: https, or http only for localhost / loopback / private LAN; no userinfo, query, link-local (169.254.x)&lt;br&gt;Speaks: messages → Anthropic format or Meta · responses → OpenAI format not set to chat" vertex="1"><mxGeometry x="60" y="420" width="520" height="130" as="geometry"/></mxCell>
                <mxCell id="router21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;internal/router&lt;/b&gt;&lt;br&gt;/llm/{id}: Catalog.Lookup per call&lt;br&gt;auth by format: Bearer · x-api-key + anthropic-version&lt;br&gt;base without a trailing /v1 · no redirects followed&lt;br&gt;Probe: unsaved profile, no cache" vertex="1"><mxGeometry x="600" y="420" width="420" height="110" as="geometry"/></mxCell>
                <mxCell id="store21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;store&lt;/b&gt;&lt;br&gt;0011 providers: id · name · format · also_anthropic · base_url · api · model · is_default (one)" vertex="1"><mxGeometry x="60" y="570" width="520" height="60" as="geometry"/></mxCell>
                <mxCell id="agents21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;plugins/agents&lt;/b&gt; Wire() · Only()&lt;br&gt;Claude Code: messages · Codex: responses · Muse Code: responses, only meta&lt;br&gt;serve offers: its own, the default, the rest; a model is needed off its own provider unless the profile has one" vertex="1"><mxGeometry x="40" y="700" width="660" height="80" as="geometry"/></mxCell>
                <mxCell id="vault21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;vault&lt;/b&gt;&lt;br&gt;provider/{id}/api_key — write-only, removed with the profile" vertex="1"><mxGeometry x="600" y="560" width="420" height="60" as="geometry"/></mxCell>
                <mxCell id="up21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;providers&lt;/b&gt;&lt;br&gt;Meta · Anthropic · OpenAI (seeded)&lt;br&gt;vLLM · Nebius · any OpenAI-compatible or Anthropic endpoint" vertex="1"><mxGeometry x="1080" y="420" width="300" height="90" as="geometry"/></mxCell>
                <mxCell id="e21a" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6C8EBF;endArrow=block" value="HTTPS, session" edge="1" source="ui21" target="api21"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e21b" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6C8EBF;endArrow=block" value="" edge="1" source="api21" target="prov21"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e21c" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6C8EBF;endArrow=block" value="" edge="1" source="prov21" target="store21"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e21d" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6C8EBF;endArrow=block" value="Lookup" edge="1" source="router21" target="prov21"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e21e" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6C8EBF;endArrow=block" value="key" edge="1" source="router21" target="vault21"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e21f" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6C8EBF;endArrow=block" value="redacted calls" edge="1" source="router21" target="up21"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e21g" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6C8EBF;endArrow=block" value="offers" edge="1" source="api21" target="agents21"><mxGeometry relative="1" as="geometry"/></mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="archcombined" name="Arch_Combined">
        <mxGraphModel dx="1750" dy="34" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="2760" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#333333" value="&lt;b&gt;ARCH_COMBINED&lt;/b&gt; — Devcules today and where it grows — one modular monolith, one trust split; blue = shipped (M0.1 → M3.3: CI/CD · config · store · bus · image + compose · auth · web shell · link · terminals · passkeys · vault · redact · router · audit + traces · MCP server · approvals and push · Muse Code), ghosts = planned (PLAN.md §9). This page gains a solid block every build." vertex="1">
