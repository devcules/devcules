                <mxCell id="a6-z-session" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;3 · SESSION&lt;/b&gt; — requireSession on every request: hash the cookie, load it, enforce both clocks, touch it" vertex="1">
                    <mxGeometry height="500" width="1090" x="40" y="476" as="geometry"/>
                </mxCell>
                <mxCell id="a6-r1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;requireSession&lt;/b&gt;&lt;br&gt;wraps every non-public route&lt;br&gt;no cookie → 401" vertex="1">
                    <mxGeometry height="86" width="240" x="70" y="545" as="geometry"/>
                </mxCell>
                <mxCell id="a6-r2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;Authenticate&lt;/b&gt;&lt;br&gt;SHA-256 the cookie value&lt;br&gt;Sessions().Get(digest)" vertex="1">
                    <mxGeometry height="86" width="240" x="340" y="545" as="geometry"/>
                </mxCell>
                <mxCell id="a6-r3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;two clocks&lt;/b&gt;&lt;br&gt;created+7 d · last-seen+12 h&lt;br&gt;at the deadline: still valid" vertex="1">
                    <mxGeometry height="86" width="250" x="610" y="545" as="geometry"/>
                </mxCell>
                <mxCell id="a6-r4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;Touch&lt;/b&gt;&lt;br&gt;a use moves the idle mark&lt;br&gt;active sessions reach 7 d" vertex="1">
                    <mxGeometry height="86" width="210" x="890" y="545" as="geometry"/>
                </mxCell>
                <mxCell id="a6-r5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;past a deadline&lt;/b&gt;&lt;br&gt;Delete on sight, then 401&lt;br&gt;401 either way" vertex="1">
                    <mxGeometry height="86" width="240" x="70" y="661" as="geometry"/>
                </mxCell>
                <mxCell id="a6-r6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;no reaper in M1.1&lt;/b&gt;&lt;br&gt;expired rows wait for&lt;br&gt;next use to be reclaimed" vertex="1">
                    <mxGeometry height="86" width="240" x="340" y="661" as="geometry"/>
                </mxCell>
                <mxCell id="a6-r7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;POST /auth/sign-out&lt;/b&gt;&lt;br&gt;session + CSRF required&lt;br&gt;Delete · cookie cleared" vertex="1">
                    <mxGeometry height="86" width="250" x="610" y="661" as="geometry"/>
                </mxCell>
                <mxCell id="a6-r8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;GET /auth/me&lt;/b&gt;&lt;br&gt;200&lt;br&gt;{&amp;quot;username&amp;quot;:&amp;quot;admin&amp;quot;}" vertex="1">
                    <mxGeometry height="86" width="210" x="890" y="661" as="geometry"/>
                </mxCell>
                <mxCell id="a6-r9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;the username rides in the request context&lt;/b&gt; — /auth/me reads it; a miswired mux answers 500, never another user" vertex="1">
                    <mxGeometry height="76" width="510" x="70" y="777" as="geometry"/>
                </mxCell>
                <mxCell id="a6-r10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;no proxy headers are trusted&lt;/b&gt; — the client IP is the connection&#39;s remote address; there is no proxy in M1.1" vertex="1">
                    <mxGeometry height="76" width="490" x="610" y="777" as="geometry"/>
                </mxCell>
                <mxCell id="a6-r11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;no roles in M1.1&lt;/b&gt; — admin is the only user and owns the machine; passkeys (M1.5), API tokens and audit events (M2.4) are not stubbed" vertex="1">
                    <mxGeometry height="76" width="1030" x="70" y="873" as="geometry"/>
