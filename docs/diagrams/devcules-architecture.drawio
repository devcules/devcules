            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t7" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#333333" value="&lt;b&gt;ARCH_6&lt;/b&gt; — Build 6 (M1.1): it authenticates. internal/auth, migration 0002, the /auth routes and the Playwright suite land; every route but /healthz, /readyz and /sign-in now needs a live session. First build with a sign-in flow, first build a browser drives." vertex="1">
                    <mxGeometry height="60" width="1090" x="40" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="legend7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8" value="How to read • blue = shipped in this build (M1.1) • grey dashed = planned module (milestone tag) • dashed + animated = the path a request takes (plays in the draw.io app) • sections 1–6 read left to right; the store and the tests back the flow" vertex="1">
                    <mxGeometry height="94" width="570" x="1140" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="a6-z-boot" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;1 · BOOTSTRAP&lt;/b&gt; — first start creates the only user; the password is printed once and never stored" vertex="1">
                    <mxGeometry height="330" width="800" x="40" y="112" as="geometry"/>
                </mxCell>
                <mxCell id="a6-b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;serve start&lt;/b&gt;&lt;br&gt;store opens at&lt;br&gt;/data/devcules.db · auth.New(s)" vertex="1">
                    <mxGeometry height="86" width="230" x="70" y="178" as="geometry"/>
                </mxCell>
                <mxCell id="a6-b2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;EnsureAdmin&lt;/b&gt;&lt;br&gt;Users().PasswordHash&lt;br&gt;(&amp;quot;admin&amp;quot;)" vertex="1">
                    <mxGeometry height="86" width="240" x="320" y="178" as="geometry"/>
                </mxCell>
                <mxCell id="a6-b3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;admin already there?&lt;/b&gt;&lt;br&gt;yes → created=false,&lt;br&gt;print nothing" vertex="1">
                    <mxGeometry height="86" width="230" x="580" y="178" as="geometry"/>
                </mxCell>
                <mxCell id="a6-b4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;GeneratePassword&lt;/b&gt;&lt;br&gt;24 chars · 52-symbol alphabet&lt;br&gt;(~137 bits)" vertex="1">
                    <mxGeometry height="86" width="230" x="580" y="310" as="geometry"/>
                </mxCell>
                <mxCell id="a6-b5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;HashPassword&lt;/b&gt;&lt;br&gt;argon2id m=64 MiB t=1 p=4&lt;br&gt;only the PHC string is stored" vertex="1">
                    <mxGeometry height="86" width="240" x="320" y="310" as="geometry"/>
