    <diagram id="arch11" name="Arch_11">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1750" pageHeight="1420" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t12" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#333333" value="&lt;b&gt;ARCH_11&lt;/b&gt; — Build 11 (M2.1): the vault. Provider keys are sealed at rest with AES-256-GCM inside serve. A vault key wraps one data key, so rotating the vault key is a single write, and every secret is bound to its name." vertex="1">
                    <mxGeometry height="60" width="1090" x="40" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="legend12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;• blue = shipped in this build (M2.1)&lt;br&gt;• grey dashed = planned module (milestone tag)&lt;br&gt;• dashed + animated = a secret on its way in or out (plays in the draw.io app)&lt;br&gt;• red = a refusal, or a known limit" vertex="1">
                    <mxGeometry height="94" width="570" x="1140" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="a11-z1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;1 · WHERE THE VAULT KEY COMES FROM&lt;/b&gt; — cmd/devcules/vault.go, at serve start" vertex="1">
                    <mxGeometry height="330" width="820" x="40" y="118" as="geometry"/>
                </mxCell>
                <mxCell id="a11-1.1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;DEVCULES_VAULT_KEY / _FILE&lt;/b&gt;&lt;br&gt;base64 of 32 bytes&lt;br&gt;validated by config" vertex="1">
                    <mxGeometry height="86" width="260" x="70" y="186" as="geometry"/>
                </mxCell>
                <mxCell id="a11-1.2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;or vault.key (generated)&lt;/b&gt;&lt;br&gt;&amp;lt;DataDir&amp;gt;/vault.key · 0600&lt;br&gt;warns: back it up with the DB" vertex="1">
                    <mxGeometry height="86" width="240" x="350" y="186" as="geometry"/>
                </mxCell>
                <mxCell id="a11-1.3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;serve-only&lt;/b&gt;&lt;br&gt;runner, machine, hook refuse&lt;br&gt;a vault key or META_API_KEY" vertex="1">
                    <mxGeometry height="86" width="220" x="610" y="186" as="geometry"/>
                </mxCell>
                <mxCell id="a11-1.4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;pending rotation settled&lt;/b&gt;&lt;br&gt;vault.key.new: committed →&lt;br&gt;rename · not committed → remove" vertex="1">
                    <mxGeometry height="86" width="260" x="70" y="312" as="geometry"/>
                </mxCell>
                <mxCell id="a11-1.5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;key id in logs&lt;/b&gt;&lt;br&gt;12 hex chars · never the key&lt;br&gt;“vault open”, key_id" vertex="1">
                    <mxGeometry height="86" width="240" x="350" y="312" as="geometry"/>
                </mxCell>
                <mxCell id="a11-1.6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;META_API_KEY&lt;/b&gt;&lt;br&gt;moved into the vault on start&lt;br&gt;then it can leave the env" vertex="1">
                    <mxGeometry height="86" width="220" x="610" y="312" as="geometry"/>
                </mxCell>
                <mxCell id="a11-z2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;2 · TWO KEYS&lt;/b&gt; — internal/vault: envelope encryption" vertex="1">
                    <mxGeometry height="330" width="820" x="890" y="118" as="geometry"/>
                </mxCell>
                <mxCell id="a11-2.1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;vault key (KEK)&lt;/b&gt;&lt;br&gt;never stored in the database&lt;br&gt;wraps the data key only" vertex="1">
                    <mxGeometry height="86" width="250" x="920" y="186" as="geometry"/>
                </mxCell>
                <mxCell id="a11-2.2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;data key (DEK)&lt;/b&gt;&lt;br&gt;32 random bytes, minted once&lt;br&gt;meta “vault.dek” (wrapped)" vertex="1">
                    <mxGeometry height="86" width="250" x="1190" y="186" as="geometry"/>
                </mxCell>
                <mxCell id="a11-2.3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;secrets&lt;/b&gt;&lt;br&gt;sealed under the DEK&lt;br&gt;name bound as associated data" vertex="1">
                    <mxGeometry height="86" width="220" x="1460" y="186" as="geometry"/>
                </mxCell>
                <mxCell id="a11-2.4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#B85450;dashed=1;fontColor=#555555;fontSize=11" value="&lt;b&gt;wrong key&lt;/b&gt;&lt;br&gt;stops serve before listening&lt;br&gt;both key ids + next steps" vertex="1">
                    <mxGeometry height="86" width="250" x="920" y="312" as="geometry"/>
                </mxCell>
                <mxCell id="a11-2.5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;seal format&lt;/b&gt;&lt;br&gt;version 1 · 12-byte nonce&lt;br&gt;AES-256-GCM ciphertext" vertex="1">
                    <mxGeometry height="86" width="250" x="1190" y="312" as="geometry"/>
                </mxCell>
                <mxCell id="a11-2.6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;no plaintext at rest&lt;/b&gt;&lt;br&gt;the store sees sealed bytes&lt;br&gt;a fresh nonce per seal" vertex="1">
                    <mxGeometry height="86" width="220" x="1460" y="312" as="geometry"/>
                </mxCell>
                <mxCell id="a11-z3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;3 · THE VAULT API&lt;/b&gt; — what serve&#x27;s other modules call (router next, M2.3)" vertex="1">
                    <mxGeometry height="470" width="1090" x="40" y="484" as="geometry"/>
                </mxCell>
                <mxCell id="a11-3.1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;Open(store, key)&lt;/b&gt;&lt;br&gt;unwraps the DEK&lt;br&gt;mints it on first open" vertex="1">
                    <mxGeometry height="86" width="240" x="70" y="552" as="geometry"/>
                </mxCell>
                <mxCell id="a11-3.2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;Put(name, value)&lt;/b&gt;&lt;br&gt;seal → Secrets().Put&lt;br&gt;“provider/meta/api_key”" vertex="1">
