                <mxCell id="cfg-parse" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11" value="&lt;b&gt;read env + defaults&lt;/b&gt;&lt;br&gt;unset → default (LISTEN 127.0.0.1:7659 · ROLE serve ·&lt;br&gt;DATA_DIR container-aware · WORKSPACE /workspace)" vertex="1">
                    <mxGeometry height="110" width="270" x="480" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="cfg-secrets" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11" value="&lt;b&gt;secrets: VAR or VAR_FILE&lt;/b&gt;&lt;br&gt;direct wins over *_FILE (file ignored&lt;br&gt;entirely — even missing)&lt;br&gt;VAULT_KEY required · RUNNER_TOKEN optional" vertex="1">
                    <mxGeometry height="110" width="270" x="790" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="cfg-checks" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11" value="&lt;b&gt;each value checked&lt;/b&gt;&lt;br&gt;ROLE ∈ {serve, runner, machine}&lt;br&gt;LISTEN host:port 1-65535&lt;br&gt;URLs http(s) with host&lt;br&gt;VAULT_KEY base64 → 32 bytes&lt;br&gt;tokens: no whitespace" vertex="1">
                    <mxGeometry height="150" width="270" x="480" y="440" as="geometry"/>
                </mxCell>
                <mxCell id="cfg-error" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11" value="&lt;b&gt;all problems, one error&lt;/b&gt;&lt;br&gt;&quot;invalid config:\n  - …\n  - …&quot;&lt;br&gt;secret values never in errors&lt;br&gt;exit 1 on the first run, not&lt;br&gt;the first bad var" vertex="1">
                    <mxGeometry height="150" width="270" x="790" y="440" as="geometry"/>
                </mxCell>
                <mxCell id="cfg-doc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;docs/config.md&lt;/b&gt;&lt;br&gt;every var · default · meaning&lt;br&gt;both-set rule documented" vertex="1">
