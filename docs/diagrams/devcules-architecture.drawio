                <mxCell id="a9-s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;browser queue&lt;/b&gt;&lt;br&gt;256 frames or 4 MiB&lt;br&gt;full → 1013, reattach redraws" vertex="1">
