                </mxCell>
                <mxCell id="a9-s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;pick the runner&lt;/b&gt;&lt;br&gt;0 → 503 / 1012 · 1 → it&lt;br&gt;2+ → ?runner=" vertex="1">
