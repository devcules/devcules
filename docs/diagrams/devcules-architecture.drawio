                    <mxGeometry height="80" width="300" x="770" y="1160" as="geometry"/>
                </mxCell>
                <mxCell id="z-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=10;fontColor=#333333" value="&lt;b&gt;Why this ships in build 1&lt;/b&gt;&lt;br&gt;&lt;br&gt;Devcules is one binary with a trust split:&lt;br&gt;• &lt;b&gt;serve&lt;/b&gt; (control plane) holds the real API keys in vault&lt;br&gt;• &lt;b&gt;runner&lt;/b&gt; / &lt;b&gt;machine&lt;/b&gt; (untrusted side) get per-launch tokens only&lt;br&gt;&lt;br&gt;Rule 1 keeps the core a modular monolith: plug-ins register through interfaces; the core never imports them.&lt;br&gt;Rule 2 keeps real keys out of the agent side.&lt;br&gt;&lt;br&gt;Today there is nothing to violate — the rules are already enforced by CI on every PR, so every future module lands inside them." vertex="1">
                    <mxGeometry height="250" width="510" x="1140" y="1030" as="geometry"/>
                </mxCell>
