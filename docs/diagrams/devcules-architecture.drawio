                <mxCell id="a13-1.6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;fontColor=#555555;fontSize=11" value="&lt;b&gt;M3.3 next&lt;/b&gt;&lt;br&gt;one token minted per&lt;br&gt;agent launch" vertex="1">
