                <mxCell id="a6-b6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;stderr, once&lt;/b&gt;&lt;br&gt;Admin password (shown once): …&lt;br&gt;never the log, never again" vertex="1">
