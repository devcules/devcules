            <mxCell id="s13-4b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;api.openai.com&lt;/b&gt;&lt;br&gt;Bearer — Responses / Chat Completions" vertex="1"><mxGeometry x="1470" y="920" width="200" height="50" as="geometry"/></mxCell>


            <mxCell id="arch-m34-note" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#666666" value="ARCH_11 — adds providers/anthropic + openai and agents/claudecode + codex (Anthropic Messages + OpenAI Responses)
ARCH_12 — machine enrolment (enrol_codes, machines), ed25519 nonce challenge, link role=machine
ARCH_13 — screen + input drivers (X11 XTest stubs, build-tagged, Xvfb-tested)
ARCH_14 — accessibility tree (AX/AT-SPI/UIA walkers) + OCR (Vision/tesseract/WinRT), one shared TSV per walker
ARCH_15 — SAM 3.1 grounding: frame + noun phrase via the router to sam-3.1, masks decoded in pure Go, largest-region centre as the click point
ARCH_16 — machine task view: screen/input/tree/ground over the link, budget at the machine, done-verifier before success" vertex="1"><mxGeometry x="40" y="1380" width="820" height="18" as="geometry"/></mxCell>

</root>
        </mxGraphModel>
    </diagram>
    <diagram id="arch4" name="Arch_4">
        <mxGraphModel dx="2708" dy="1310" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1340" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t5" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#333333" value="ARCH_4 — Build 4 (M0.4): the event bus — internal/bus (the surface) · internal/bus/memory (the backend) · bustest (the contract suite). Nothing publishes yet: serve wires it in M0.5." vertex="1">
                    <mxGeometry height="60" width="1150" x="40" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="legend5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;• blue = shipped in this build (M0.4)&lt;br&gt;• solid grey = static relation&lt;br&gt;• grey dashed ghost = later module&lt;br&gt;• green = the deliberate contract, not a limitation" vertex="1">
                    <mxGeometry height="120" width="330" x="1380" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="busif-zone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;internal/bus — the surface&lt;/b&gt;&lt;br&gt;three methods, two sentinels — the whole in-process messaging a role may use" vertex="1">
                    <mxGeometry height="560" width="400" x="60" y="200" as="geometry"/>
                </mxCell>
                <mxCell id="bu-if" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12" value="&lt;b&gt;Bus&lt;/b&gt; — the whole surface a role needs&lt;br&gt;Publish · Subscribe · Close — idempotent&lt;br&gt;transient events, nothing else" vertex="1">
                    <mxGeometry height="90" width="360" x="80" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="bu-pub" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;Publish — at-most-once, never blocks&lt;/b&gt;&lt;br&gt;delivers to every current subscriber of the topic&lt;br&gt;in publish order per subscriber · full buffer&lt;br&gt;→ drops for that subscriber only" vertex="1">
                    <mxGeometry height="110" width="360" x="80" y="420" as="geometry"/>
                </mxCell>
                <mxCell id="bu-sent" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;ErrClosed · ErrBadTopic&lt;/b&gt; — typed errors&lt;br&gt;use after Close · empty topic —&lt;br&gt;wrapped with %w, matched with errors.Is" vertex="1">
                    <mxGeometry height="90" width="360" x="80" y="560" as="geometry"/>
                </mxCell>
                <mxCell id="bu-rule" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11" value="&lt;b&gt;how a backend grows&lt;/b&gt; (docs/bus.md)&lt;br&gt;interface PR → contract suite → backend passes it" vertex="1">
                    <mxGeometry height="80" width="360" x="80" y="670" as="geometry"/>
                </mxCell>
                <mxCell id="mem-zone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;internal/bus/memory — the backend&lt;/b&gt;&lt;br&gt;plain channels and one mutex — the standard library only, no goroutine leaks" vertex="1">
                    <mxGeometry height="560" width="640" x="500" y="200" as="geometry"/>
                </mxCell>
                <mxCell id="me-open" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11" value="&lt;b&gt;memory.New()&lt;/b&gt;&lt;br&gt;map[topic]map[*subscriber]struct{}&lt;br&gt;buffered 64 per subscriber&lt;br&gt;no persistence · no replay · no wildcards" vertex="1">
                    <mxGeometry height="130" width="280" x="520" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="me-copy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11" value="&lt;b&gt;copies both ways&lt;/b&gt;&lt;br&gt;Publish clones the message per subscriber:&lt;br&gt;the caller reuses its buffer,&lt;br&gt;subscribers cannot corrupt each other" vertex="1">
                    <mxGeometry height="130" width="280" x="840" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="me-watch" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11" value="&lt;b&gt;one watcher goroutine per subscription&lt;/b&gt;&lt;br&gt;wakes on ctx.Done or Close,&lt;br&gt;removes the entry and closes the channel — once" vertex="1">
                    <mxGeometry height="90" width="280" x="520" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="me-drop" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11" value="&lt;b&gt;full buffer drops, never blocks&lt;/b&gt;&lt;br&gt;a non-blocking send that fails&lt;br&gt;is the drop — Publish returns instantly" vertex="1">
                    <mxGeometry height="90" width="280" x="840" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="me-close" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11" value="&lt;b&gt;Close: everything ends&lt;/b&gt;&lt;br&gt;closes every channel under the mutex,&lt;br&gt;so Publish never sends on a closed one&lt;br&gt;repeat → no-op · watchers exit" vertex="1">
                    <mxGeometry height="110" width="280" x="520" y="570" as="geometry"/>
                </mxCell>
                <mxCell id="me-test" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;own tests beyond the suite&lt;/b&gt;&lt;br&gt;watchers drain · unsubscribe forgets&lt;br&gt;the topic map — no slow leak" vertex="1">
                    <mxGeometry height="110" width="280" x="840" y="570" as="geometry"/>
                </mxCell>
                <mxCell id="busu-zone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;internal/bus/bustest — the contract suite&lt;/b&gt;&lt;br&gt;Run(t, newBus) wires one constructor — every backend, same behaviour" vertex="1">
                    <mxGeometry height="560" width="560" x="1180" y="200" as="geometry"/>
                </mxCell>
                <mxCell id="bt-run" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12" value="&lt;b&gt;Run(t, newBus)&lt;/b&gt; — one constructor, the same behaviour everywhere:&lt;br&gt;fan-out · no cross-topic leak · late subscriber misses history&lt;br&gt;copy isolation · slow-drop · unsubscribe closes · Close closes all&lt;br&gt;bad topic · cancelled ctx · concurrent publishers · no goroutine leak" vertex="1">
                    <mxGeometry height="130" width="500" x="1200" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="bt-fake" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;in-memory fake&lt;/b&gt;&lt;br&gt;the suite passes on a correct backend — its checks are not vacuous" vertex="1">
                    <mxGeometry height="110" width="240" x="1200" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="bt-probe" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;broken-bus probe&lt;/b&gt;&lt;br&gt;a child process proves the suite fails a bus that delivers nothing" vertex="1">
                    <mxGeometry height="110" width="230" x="1470" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="bt-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=10;fontColor=#333333" value="&lt;b&gt;Why this ships in build 4&lt;/b&gt; — every later module publishes on this surface; one shared suite proves the delivery rules once (drop · order · isolation) instead of each module re-testing its backend." vertex="1">
                    <mxGeometry height="100" width="500" x="1200" y="590" as="geometry"/>
                </mxCell>
                <mxCell id="zoom4-zone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;Zoom — Publish meets a full buffer&lt;/b&gt; — and why the contract says drop, not block" vertex="1">
                    <mxGeometry height="240" width="1630" x="60" y="800" as="geometry"/>
                </mxCell>
                <mxCell id="z4-pub" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11" value="&lt;b&gt;Publish(topic, msg)&lt;/b&gt;&lt;br&gt;clones the message, then delivers to each&lt;br&gt;subscriber with a non-blocking send" vertex="1">
                    <mxGeometry height="110" width="350" x="100" y="890" as="geometry"/>
                </mxCell>
                <mxCell id="z4-slow" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11" value="&lt;b&gt;slow subscriber — buffer full&lt;/b&gt;&lt;br&gt;the send fails, the message drops&lt;br&gt;for that subscriber only" vertex="1">
                    <mxGeometry height="110" width="350" x="500" y="890" as="geometry"/>
                </mxCell>
                <mxCell id="z4-fast" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11" value="&lt;b&gt;every other subscriber&lt;/b&gt;&lt;br&gt;still gets the message in publish order —&lt;br&gt;one slow reader never stalls the process" vertex="1">
                    <mxGeometry height="110" width="350" x="900" y="890" as="geometry"/>
                </mxCell>
                <mxCell id="z4-why" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11" value="&lt;b&gt;why drop is the contract&lt;/b&gt;&lt;br&gt;backpressure would couple a terminal view&lt;br&gt;to a model call; lossless delivery is the&lt;br&gt;store&#39;s job, a different module" vertex="1">
                    <mxGeometry height="110" width="360" x="1300" y="890" as="geometry"/>
                </mxCell>
                <mxCell id="next4-zone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;NEXT — enabled by this build&lt;/b&gt; — every later module publishes on this surface instead of growing its own queue" vertex="1">
                    <mxGeometry height="200" width="1630" x="60" y="1080" as="geometry"/>
                </mxCell>
                <mxCell id="n4-pg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;fontColor=#555555;fontSize=11" value="&lt;b&gt;pg LISTEN/NOTIFY&lt;/b&gt; (stretch)&lt;br&gt;same contract, reads DATABASE_URL" vertex="1">
                    <mxGeometry height="80" width="300" x="100" y="1170" as="geometry"/>
                </mxCell>
                <mxCell id="n4-serve" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;fontColor=#555555;fontSize=11" value="&lt;b&gt;serve opens it&lt;/b&gt; (M0.5)&lt;br&gt;the first real publisher" vertex="1">
                    <mxGeometry height="80" width="300" x="440" y="1170" as="geometry"/>
                </mxCell>
                <mxCell id="n4-term" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;fontColor=#555555;fontSize=11" value="&lt;b&gt;terminal output frames&lt;/b&gt; (M1.4)&lt;br&gt;the relay&#39;s fan-out path" vertex="1">
                    <mxGeometry height="80" width="300" x="780" y="1170" as="geometry"/>
                </mxCell>
                <mxCell id="n4-approv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;fontColor=#555555;fontSize=11" value="&lt;b&gt;approval events&lt;/b&gt; (M3)&lt;br&gt;pending-decision buzzes" vertex="1">
                    <mxGeometry height="80" width="240" x="1120" y="1170" as="geometry"/>
                </mxCell>
                <mxCell id="n4-audit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;fontColor=#555555;fontSize=11" value="&lt;b&gt;audit trails&lt;/b&gt; (M2)&lt;br&gt;append-only, not the bus&#39;s job" vertex="1">
                    <mxGeometry height="80" width="260" x="1400" y="1170" as="geometry"/>
                </mxCell>
                <mxCell id="b1" edge="1" parent="1" source="bu-if" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#999999;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFFexitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="bu-pub" value="the delivery rule">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="b2" edge="1" parent="1" source="bu-pub" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#999999;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFFexitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="bu-sent" value="empty topic / after Close">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="b12" edge="1" parent="1" source="bu-if" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#999999;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFFexitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="me-open" value="implements">
