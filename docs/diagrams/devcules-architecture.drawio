                <mxCell id="a6-p1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;public&lt;/b&gt;&lt;br&gt;/healthz · /readyz&lt;br&gt;GET /sign-in" vertex="1">
