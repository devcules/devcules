                <mxCell id="a6-z-signin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;2 · SIGN IN&lt;/b&gt; — POST /auth/sign-in: rate-limited, one argon2id check, one 401 for every failure" vertex="1">
                    <mxGeometry height="330" width="840" x="870" y="112" as="geometry"/>
                </mxCell>
                <mxCell id="a6-s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;GET /sign-in&lt;/b&gt;&lt;br&gt;no-JS form, go:embed&lt;br&gt;(M1.2 shell replaces it)" vertex="1">
                    <mxGeometry height="86" width="240" x="900" y="178" as="geometry"/>
                </mxCell>
                <mxCell id="a6-s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;POST /auth/sign-in&lt;/b&gt;&lt;br&gt;urlencoded username + password&lt;br&gt;behind the CSRF check" vertex="1">
                    <mxGeometry height="86" width="240" x="1160" y="178" as="geometry"/>
                </mxCell>
                <mxCell id="a6-s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;rate limit&lt;/b&gt;&lt;br&gt;5 failures / 60 s per client IP&lt;br&gt;429 + Retry-After: 60&lt;br&gt;success clears the count" vertex="1">
                    <mxGeometry height="86" width="260" x="1420" y="178" as="geometry"/>
                </mxCell>
                <mxCell id="a6-s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;one argon2id check&lt;/b&gt;&lt;br&gt;unknown user → dummy hash&lt;br&gt;one 401 for both:&lt;br&gt;no enumeration" vertex="1">
                    <mxGeometry height="86" width="260" x="1420" y="310" as="geometry"/>
                </mxCell>
                <mxCell id="a6-s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;mint session&lt;/b&gt;&lt;br&gt;32 random bytes, hex&lt;br&gt;store keeps the SHA-256" vertex="1">
                    <mxGeometry height="86" width="240" x="1160" y="310" as="geometry"/>
                </mxCell>
                <mxCell id="a6-s6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;303 → /&lt;/b&gt;&lt;br&gt;HttpOnly · Secure · Strict&lt;br&gt;Path=/ · MaxAge 7 d" vertex="1">
