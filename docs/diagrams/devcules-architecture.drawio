                <mxCell id="a9-s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;attach (5 s)&lt;/b&gt;&lt;br&gt;stream registered first, so tmux’s&lt;br&gt;first redraw is never dropped" vertex="1">
                    <mxGeometry height="86" width="240" x="1440" y="186" as="geometry"/>
