                </mxCell>
                <mxCell id="a5-smoke" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;smoke.sh&lt;/b&gt; — runs against an already-up stack&lt;br&gt;&lt;font face=&#39;Courier New&#39;&gt;up -d --wait&lt;/font&gt; gates on health before it starts" vertex="1">
                    <mxGeometry height="82" width="504" x="1178" y="540" as="geometry"/>
                </mxCell>
                <mxCell id="a5-smoke-list" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#333333" value="• &lt;font face=&#39;Courier New&#39;&gt;GET /healthz&lt;/font&gt; = ok &amp;nbsp;•&amp;nbsp; &lt;font face=&#39;Courier New&#39;&gt;GET /readyz&lt;/font&gt; = ok&lt;br&gt;• serve runs as uid 10001&lt;br&gt;• serve + runner: ReadonlyRootfs = true, running&lt;br&gt;• runner runs as uid 10001, has no vault key&lt;br&gt;• published port is 127.0.0.1:7659 only&lt;br&gt;• &lt;font face=&#39;Courier New&#39;&gt;stop -t 20&lt;/font&gt; finishes in under 20 s&lt;br&gt;• serve exit code is 0 (not 143/137)&lt;br&gt;&lt;br&gt;&lt;i&gt;a red result dumps both logs, then tears the stack down&lt;/i&gt;" vertex="1">
