                <mxCell id="a7-z-serve" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;3 · SERVE&lt;/b&gt; — the app is public bytes; the data behind it is not. Sign-in hands JS a 204, not a redirect" vertex="1">
                    <mxGeometry height="470" width="1090" x="40" y="484" as="geometry"/>
                </mxCell>
                <mxCell id="a7-s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;GET /&lt;/b&gt;&lt;br&gt;root: app for GET/HEAD&lt;br&gt;anything else → session" vertex="1">
                    <mxGeometry height="86" width="240" x="70" y="552" as="geometry"/>
                </mxCell>
                <mxCell id="a7-s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;internal/web&lt;/b&gt;&lt;br&gt;SPA fallback on HTML nav&lt;br&gt;405 for other methods" vertex="1">
                    <mxGeometry height="86" width="250" x="340" y="552" as="geometry"/>
                </mxCell>
                <mxCell id="a7-s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;cache rules&lt;/b&gt;&lt;br&gt;/assets/* immutable 1 y&lt;br&gt;the rest no-cache" vertex="1">
                    <mxGeometry height="86" width="240" x="620" y="552" as="geometry"/>
                </mxCell>
                <mxCell id="a7-s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;unbuilt&lt;/b&gt;&lt;br&gt;503 + the build command&lt;br&gt;never an empty app" vertex="1">
                    <mxGeometry height="86" width="220" x="890" y="552" as="geometry"/>
                </mxCell>
                <mxCell id="a7-s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;POST /auth/sign-in&lt;/b&gt;&lt;br&gt;204 + session cookie&lt;br&gt;the old 303 is gone" vertex="1">
                    <mxGeometry height="86" width="240" x="70" y="664" as="geometry"/>
                </mxCell>
                <mxCell id="a7-s6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;404 on /auth/*&lt;/b&gt;&lt;br&gt;never falls back to&lt;br&gt;the app shell" vertex="1">
                    <mxGeometry height="86" width="250" x="340" y="664" as="geometry"/>
                </mxCell>
                <mxCell id="a7-s7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;security headers&lt;/b&gt;&lt;br&gt;CSP default-src self ·&lt;br&gt;base-uri none · form-action self" vertex="1">
                    <mxGeometry height="86" width="240" x="620" y="664" as="geometry"/>
                </mxCell>
                <mxCell id="a7-s8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;nosniff&lt;/b&gt;&lt;br&gt;no-referrer&lt;br&gt;frame-ancestors none" vertex="1">
                    <mxGeometry height="86" width="220" x="890" y="664" as="geometry"/>
                </mxCell>
                <mxCell id="a7-s9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;the static app is public on purpose&lt;/b&gt; — it holds no data and checks the session itself; every read that does holds data stays behind requireSession" vertex="1">
                    <mxGeometry height="76" width="510" x="70" y="780" as="geometry"/>
                </mxCell>
                <mxCell id="a7-s10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;no data in the shell&lt;/b&gt; — /auth/* never falls back to index.html, so a mistyped API path 404s instead of returning HTML" vertex="1">
                    <mxGeometry height="76" width="490" x="620" y="780" as="geometry"/>
                </mxCell>
                <mxCell id="a7-s11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;still loopback only&lt;/b&gt; — the port is 127.0.0.1:7659; phone access over tailscale is a later deploy step, not in this build" vertex="1">
