                <mxCell id="t18" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#333333" value="&lt;b&gt;ARCH_17&lt;/b&gt; — Build 17 (M3.3): Muse Code. The owner taps Start in Terminals; serve mints a launch token for that runner, and the runner starts Muse Code in tmux with its model calls on the router, Devcules&#x27; MCP tools, and devcules hook before every tool call." vertex="1">
                    <mxGeometry height="60" width="1090" x="40" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="legend18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;• blue = shipped in this build (M3.3)&lt;br&gt;• grey dashed = planned module (milestone tag)&lt;br&gt;• dashed + animated = a launch on its way from the phone to the agent (plays in the draw.io app)&lt;br&gt;• red = a refusal, or a known limit" vertex="1">
