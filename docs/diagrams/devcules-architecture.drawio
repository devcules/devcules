                </mxCell>
                <mxCell id="a12-1.3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;EMAIL · PHONE&lt;/b&gt;&lt;br&gt;addresses · + international&lt;br&gt;and 10-digit national numbers" vertex="1">
