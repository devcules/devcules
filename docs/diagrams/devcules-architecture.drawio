                </mxCell>
                <mxCell id="a7-x5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;fontColor=#555555;fontSize=11" value="&lt;b&gt;every later screen reuses this&lt;/b&gt; — tokens, shell, the 401 → sign-in rule and the visual-baseline habit" vertex="1">
