                    <mxGeometry height="86" width="260" x="70" y="312" as="geometry"/>
                </mxCell>
                <mxCell id="a9-w5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;resume&lt;/b&gt;&lt;br&gt;visibilitychange + online reattach&lt;br&gt;locking the phone loses nothing" vertex="1">
