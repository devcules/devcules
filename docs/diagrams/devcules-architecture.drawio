                </mxCell>
                <mxCell id="run-version" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12" value="&lt;b&gt;version&lt;/b&gt;&lt;br&gt;no config needed — works&lt;br&gt;even when setup is broken" vertex="1">
                    <mxGeometry height="90" width="240" x="1160" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="run-role" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11" value="&lt;b&gt;serve · runner · machine · hook&lt;/b&gt;&lt;br&gt;&quot;NAME: listening on LISTEN,&lt;br&gt;data in DATA_DIR&quot; + stub note" vertex="1">
                    <mxGeometry height="90" width="240" x="1430" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="run-health" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11" value="&lt;b&gt;health&lt;/b&gt;&lt;br&gt;GET http://LISTEN/healthz (5s)&lt;br&gt;2xx → 0 · else exit 1&lt;br&gt;endpoint itself: &lt;font color=&#39;#CC6600&#39;&gt;&lt;b&gt;SKIP → M0.5&lt;/b&gt;&lt;/font&gt;" vertex="1">
                    <mxGeometry height="100" width="240" x="1160" y="410" as="geometry"/>
                </mxCell>
                <mxCell id="run-badcfg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11" value="&lt;b&gt;bad config&lt;/b&gt;&lt;br&gt;error to stderr, exit 1&lt;br&gt;usage only for wrong invocation&lt;br&gt;(exit 2)" vertex="1">
                    <mxGeometry height="100" width="240" x="1430" y="410" as="geometry"/>
                </mxCell>
                <mxCell id="run-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=10;fontColor=#333333" value="&lt;b&gt;Why this ships in build 2&lt;/b&gt; — the trust split&#39;s first real seam: every role reads the same validated config, and the vault key is read only as bytes + a path — config never decodes, logs or passes it around; internal/vault does that in M2." vertex="1">
                    <mxGeometry height="110" width="510" x="1160" y="540" as="geometry"/>
                </mxCell>
                <mxCell id="run-ldflags" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11" value="&lt;b&gt;release wiring&lt;/b&gt; — .goreleaser.yaml injects version · commit · date via -X flags; local builds say dev/none/unknown" vertex="1">
                    <mxGeometry height="70" width="510" x="1160" y="670" as="geometry"/>
                </mxCell>
                <mxCell id="zoom2-zone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;Zoom — the both-set rule and container-aware defaults&lt;/b&gt; — the two behaviours most likely to surprise, locked in by tests" vertex="1">
                    <mxGeometry height="240" width="1630" x="60" y="800" as="geometry"/>
                </mxCell>
                <mxCell id="z2-bothset" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11" value="&lt;b&gt;DEVCULES_VAULT_KEY vs DEVCULES_VAULT_KEY_FILE&lt;/b&gt;&lt;br&gt;direct set → file ignored entirely (even missing/unreadable)&lt;br&gt;only direct unset → file read (trimmed) · neither + required → one problem" vertex="1">
                    <mxGeometry height="110" width="500" x="100" y="890" as="geometry"/>
                </mxCell>
                <mxCell id="z2-datadir" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11" value="&lt;b&gt;DEVCULES_DATA_DIR&lt;/b&gt;&lt;br&gt;unset → /data inside a container (marker file + PID 1 cgroup)&lt;br&gt;else ~/.local/share/devcules · set → must be absolute" vertex="1">
                    <mxGeometry height="110" width="480" x="660" y="890" as="geometry"/>
                </mxCell>
                <mxCell id="z2-out" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11" value="&lt;b&gt;one error, all problems&lt;/b&gt;&lt;br&gt;invalid config:&lt;br&gt;&amp;nbsp;&amp;nbsp;- DEVCULES_ROLE invalid: &quot;root&quot; (want serve, runner or machine)&lt;br&gt;&amp;nbsp;&amp;nbsp;- DEVCULES_LISTEN invalid: …" vertex="1">
                    <mxGeometry height="110" width="460" x="1200" y="890" as="geometry"/>
                </mxCell>
                <mxCell id="next-zone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;NEXT — enabled by this build&lt;/b&gt; — every later module parses the same config and grows one of these ghost boxes" vertex="1">
                    <mxGeometry height="200" width="1630" x="60" y="1080" as="geometry"/>
                </mxCell>
                <mxCell id="n-store" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;store&lt;/b&gt; (M0.3 ✓ → Arch_3)&lt;br&gt;Store · SQLite backend · storetest" vertex="1">
                    <mxGeometry height="80" width="300" x="100" y="1170" as="geometry"/>
                </mxCell>
                <mxCell id="n-healthz" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;fontColor=#555555;fontSize=11" value="&lt;b&gt;/healthz · /readyz&lt;/b&gt; (M0.5)&lt;br&gt;the endpoint devcules health probes" vertex="1">
                    <mxGeometry height="80" width="300" x="440" y="1170" as="geometry"/>
                </mxCell>
                <mxCell id="n-serve" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;fontColor=#555555;fontSize=11" value="&lt;b&gt;the real serve&lt;/b&gt; (M0.2+ stub → M0.5 up)&lt;br&gt;same binary, same config" vertex="1">
