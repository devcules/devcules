                <mxCell id="a8-x1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;fontColor=#555555;fontSize=11" value="&lt;b&gt;no terminal frames&lt;/b&gt;&lt;br&gt;M1.4 registers term.* types&lt;br&gt;with hub.On and the dialer’s On" vertex="1">
                    <mxGeometry height="86" width="360" x="920" y="1042" as="geometry"/>
                </mxCell>
                <mxCell id="a8-x2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;fontColor=#555555;fontSize=11" value="&lt;b&gt;no machine role&lt;/b&gt;&lt;br&gt;hello with role machine is refused&lt;br&gt;until M4.1 (ed25519 enrolment)" vertex="1">
                    <mxGeometry height="86" width="370" x="1310" y="1042" as="geometry"/>
                </mxCell>
                <mxCell id="a8-x3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;fontColor=#555555;fontSize=11" value="&lt;b&gt;no request/response layer&lt;/b&gt;&lt;br&gt;Send and On only; an RPC layer&lt;br&gt;lands when a module needs one" vertex="1">
                    <mxGeometry height="86" width="360" x="920" y="1164" as="geometry"/>
                </mxCell>
                <mxCell id="a8-x4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;fontColor=#555555;fontSize=11" value="&lt;b&gt;M1.4 terminals&lt;/b&gt;&lt;br&gt;tmux PTYs ride this link; the welcome&lt;br&gt;session keys state per link generation" vertex="1">
                    <mxGeometry height="86" width="370" x="1310" y="1164" as="geometry"/>
                </mxCell>
                <mxCell id="a8-x5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;fontColor=#555555;fontSize=11" value="&lt;b&gt;the link is the only way into the runner&lt;/b&gt; — nothing listens on the runner side, and the runner never holds the vault (arch_test.go)" vertex="1">
                    <mxGeometry height="66" width="760" x="920" y="1286" as="geometry"/>
                </mxCell>
            
            <mxCell id="s13-4a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;api.anthropic.com&lt;/b&gt;&lt;br&gt;x-api-key — Claude Messages, count_tokens" vertex="1"><mxGeometry x="1260" y="920" width="190" height="50" as="geometry"/></mxCell>
            <mxCell id="s13-4b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;api.openai.com&lt;/b&gt;&lt;br&gt;Bearer — Responses / Chat Completions" vertex="1"><mxGeometry x="1470" y="920" width="200" height="50" as="geometry"/></mxCell>


            <mxCell id="arch-m34-note" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#666666" value="ARCH_11 — adds providers/anthropic + openai and agents/claudecode + codex (Anthropic Messages + OpenAI Responses)
ARCH_12 — machine enrolment (enrol_codes, machines), ed25519 nonce challenge, link role=machine
ARCH_13 — screen + input drivers (X11 XTest stubs, build-tagged, Xvfb-tested)
ARCH_14 — accessibility tree (AX/AT-SPI/UIA walkers) + OCR (Vision/tesseract/WinRT), one shared TSV per walker
ARCH_15 — SAM 3.1 grounding: frame + noun phrase via the router to sam-3.1, masks decoded in pure Go, largest-region centre as the click point
ARCH_16 — machine task view: screen/input/tree/ground over the link, budget at the machine, done-verifier before success" vertex="1"><mxGeometry x="40" y="1380" width="820" height="18" as="geometry"/></mxCell>

</root>
        </mxGraphModel>
    </diagram>
    <diagram id="arch9" name="Arch_9">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1750" pageHeight="1420" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t10" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#333333" value="&lt;b&gt;ARCH_9&lt;/b&gt; — Build 9 (M1.4): real terminals. The runner drives one private tmux server, serve relays each browser&#39;s stream over the link, and the Terminals tab renders it with xterm.js and a phone key strip. tmux is the only buffer: every attach redraws, so reloads, phone locks and relinks resume." vertex="1">
                    <mxGeometry height="60" width="1090" x="40" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="legend10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;• blue = shipped in this build (M1.4, plus step 0 hub events in PR #41)&lt;br&gt;• grey dashed = planned module (milestone tag)&lt;br&gt;• dashed + animated = keystrokes and output on their way (plays in the draw.io app)&lt;br&gt;• red = a stream cut off, or a known limit" vertex="1">
                    <mxGeometry height="94" width="570" x="1140" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="a9-z-web" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;1 · TERMINALS TAB&lt;/b&gt; — web/src/screens: xterm.js renders, the key strip types" vertex="1">
                    <mxGeometry height="330" width="820" x="40" y="118" as="geometry"/>
                </mxCell>
                <mxCell id="a9-w1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;Terminals list&lt;/b&gt;&lt;br&gt;New terminal · open · close with a confirm&lt;br&gt;GET / POST / DELETE /api/terminals" vertex="1">
                    <mxGeometry height="86" width="260" x="70" y="186" as="geometry"/>
                </mxCell>
                <mxCell id="a9-w2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;TerminalView&lt;/b&gt;&lt;br&gt;@xterm/xterm + addon-fit (MIT)&lt;br&gt;binary = bytes · text = resize" vertex="1">
                    <mxGeometry height="86" width="240" x="350" y="186" as="geometry"/>
                </mxCell>
                <mxCell id="a9-w3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;phone key strip&lt;/b&gt;&lt;br&gt;Esc · Tab · sticky Ctrl · arrows · Enter&lt;br&gt;44 px · keeps focus · rides the keyboard" vertex="1">
                    <mxGeometry height="86" width="220" x="610" y="186" as="geometry"/>
                </mxCell>
