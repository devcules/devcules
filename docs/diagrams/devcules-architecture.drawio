                </mxCell>
                <mxCell id="a7-n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;fontColor=#555555;fontSize=11" value="&lt;b&gt;no agent board&lt;/b&gt;&lt;br&gt;Home says what it means:&lt;br&gt;nothing needs you yet (M3)" vertex="1">
