                </mxCell>
                <mxCell id="cfg-tests" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;table tests&lt;/b&gt;&lt;br&gt;every env var + bad-config&lt;br&gt;error messages asserted&lt;br&gt;(M0.2 test gate)" vertex="1">
                    <mxGeometry height="110" width="270" x="790" y="620" as="geometry"/>
                </mxCell>
                <mxCell id="run-zone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;what a run does (M0.2)&lt;/b&gt;&lt;br&gt;validate → report → exit · nothing starts" vertex="1">
