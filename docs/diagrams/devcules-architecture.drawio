                </mxCell>
                <mxCell id="legend3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;• blue = shipped in this build (M0.2)&lt;br&gt;• solid grey = static relation / data flow&lt;br&gt;• grey dashed ghost = next milestone&lt;br&gt;• exit codes: 0 done · 1 config/run failed · 2 wrong invocation" vertex="1">
                    <mxGeometry height="120" width="330" x="1380" y="30" as="geometry"/>
                </mxCell>
