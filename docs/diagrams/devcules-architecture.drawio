    <diagram id="arch12" name="Arch_12">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1750" pageHeight="1420" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t13" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#333333" value="&lt;b&gt;ARCH_12&lt;/b&gt; — Build 12 (M2.2): redaction. Secrets and optional personal data are swapped for deterministic placeholders before any text reaches a model, and put back in the reply, streamed replies included. Values are never logged or returned." vertex="1">
                    <mxGeometry height="60" width="1090" x="40" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="legend13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;• blue = shipped in this build (M2.2)&lt;br&gt;• grey dashed = planned module (milestone tag)&lt;br&gt;• dashed + animated = text on its way to or from a model (plays in the draw.io app)&lt;br&gt;• red = a refusal, or a known limit" vertex="1">
                    <mxGeometry height="94" width="570" x="1140" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="a12-z1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;1 · DETECTORS&lt;/b&gt; — internal/redact, one type per family" vertex="1">
                    <mxGeometry height="330" width="820" x="40" y="118" as="geometry"/>
                </mxCell>
                <mxCell id="a12-1.1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;SECRET&lt;/b&gt;&lt;br&gt;221 Gitleaks v8.30.1 rules&lt;br&gt;rule data as JSON · MIT notice" vertex="1">
                    <mxGeometry height="86" width="260" x="70" y="186" as="geometry"/>
                </mxCell>
                <mxCell id="a12-1.2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;our own matcher&lt;/b&gt;&lt;br&gt;keywords → regex → secret group&lt;br&gt;→ entropy → allowlists" vertex="1">
