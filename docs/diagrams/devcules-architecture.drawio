            <mxCell id="s13-4a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;api.anthropic.com&lt;/b&gt;&lt;br&gt;x-api-key — Claude Messages, count_tokens" vertex="1"><mxGeometry x="1260" y="920" width="190" height="50" as="geometry"/></mxCell>
            <mxCell id="s13-4b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;api.openai.com&lt;/b&gt;&lt;br&gt;Bearer — Responses / Chat Completions" vertex="1"><mxGeometry x="1470" y="920" width="200" height="50" as="geometry"/></mxCell>


            <mxCell id="arch-m34-note" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#666666" value="ARCH_11 — adds providers/anthropic + openai and agents/claudecode + codex (Anthropic Messages + OpenAI Responses)
ARCH_12 — machine enrolment (enrol_codes, machines), ed25519 nonce challenge, link role=machine
ARCH_13 — screen + input drivers (X11 XTest stubs, build-tagged, Xvfb-tested)
ARCH_14 — accessibility tree (AX/AT-SPI/UIA walkers) + OCR (Vision/tesseract/WinRT), one shared TSV per walker
ARCH_15 — SAM 3.1 grounding: frame + noun phrase via the router to sam-3.1, masks decoded in pure Go, largest-region centre as the click point
ARCH_16 — machine task view: screen/input/tree/ground over the link, budget at the machine, done-verifier before success" vertex="1"><mxGeometry x="40" y="1380" width="820" height="18" as="geometry"/></mxCell>

</root>
        </mxGraphModel>
    </diagram>
    <diagram id="arch8" name="Arch_8">
        <mxGraphModel dx="2025" dy="1347" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1420" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t9" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#333333" value="&lt;b&gt;ARCH_8&lt;/b&gt; — Build 8 (M1.3): the runner stops idling. internal/link defines one strict frame, the hub serves GET /link inside serve, and the runner dials out with a bearer token, heartbeats and backoff. Nothing listens on the runner side; serve counts linked runners in /readyz." vertex="1">
                    <mxGeometry height="60" width="1090" x="40" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="legend9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;• blue = shipped in this build (M1.3)&lt;br&gt;• grey dashed = planned module (milestone tag)&lt;br&gt;• dashed + animated = the path a link takes (plays in the draw.io app)&lt;br&gt;• red = a refusal: the link never comes up" vertex="1">
                    <mxGeometry height="94" width="570" x="1140" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="a8-z-frame" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;1 · FRAMES&lt;/b&gt; — internal/link: one envelope, decoded strictly, shared by both ends" vertex="1">
                    <mxGeometry height="330" width="820" x="40" y="118" as="geometry"/>
                </mxCell>
                <mxCell id="a8-f1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;Frame&lt;/b&gt;&lt;br&gt;{&quot;v&quot;:1, &quot;type&quot;, &quot;id&quot;, &quot;data&quot;}&lt;br&gt;versioned from day one" vertex="1">
                    <mxGeometry height="86" width="240" x="70" y="186" as="geometry"/>
                </mxCell>
                <mxCell id="a8-f2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;Decode — strict&lt;/b&gt;&lt;br&gt;unknown fields · trailing data&lt;br&gt;v ≠ 1 · missing data → rejected" vertex="1">
                    <mxGeometry height="86" width="240" x="340" y="186" as="geometry"/>
                </mxCell>
                <mxCell id="a8-f3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;type and id&lt;/b&gt;&lt;br&gt;type ^[a-z][a-z0-9.]{0,31}$&lt;br&gt;id 1–64 characters" vertex="1">
                    <mxGeometry height="86" width="220" x="610" y="186" as="geometry"/>
                </mxCell>
                <mxCell id="a8-f4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;data stays raw&lt;/b&gt;&lt;br&gt;json.RawMessage&lt;br&gt;each handler decodes its own" vertex="1">
                    <mxGeometry height="86" width="220" x="610" y="312" as="geometry"/>
                </mxCell>
                <mxCell id="a8-f5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;1 MiB per frame&lt;/b&gt;&lt;br&gt;read limit on both ends&lt;br&gt;oversize → 1009" vertex="1">
                    <mxGeometry height="86" width="240" x="340" y="312" as="geometry"/>
                </mxCell>
                <mxCell id="a8-f6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;FuzzDecode&lt;/b&gt;&lt;br&gt;never panics · round-trips&lt;br&gt;seed corpus · 30 s in CI" vertex="1">
