            <mxCell id="arch-m34-note" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#666666" value="ARCH_11 — adds providers/anthropic + openai and agents/claudecode + codex (Anthropic Messages + OpenAI Responses)
ARCH_12 — machine enrolment (enrol_codes, machines), ed25519 nonce challenge, link role=machine
ARCH_13 — screen + input drivers (X11 XTest stubs, build-tagged, Xvfb-tested)
ARCH_14 — accessibility tree (AX/AT-SPI/UIA walkers) + OCR (Vision/tesseract/WinRT), one shared TSV per walker
ARCH_15 — SAM 3.1 grounding: frame + noun phrase via the router to sam-3.1, masks decoded in pure Go, largest-region centre as the click point
ARCH_16 — machine task view: screen/input/tree/ground over the link, budget at the machine, done-verifier before success" vertex="1"><mxGeometry x="40" y="1380" width="820" height="18" as="geometry"/></mxCell>

</root>
        </mxGraphModel>
    </diagram>
    <diagram id="arch18" name="Arch_18">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1750" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t19" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#333333" value="&lt;b&gt;ARCH_18&lt;/b&gt; — Machines and Projects, tied together: a computer enrols with a one-time code and its own ed25519 key, links by signing a fresh challenge, and serves its screen and a tmux shell over that link (no inbound port). Projects name a directory on a runner or machine; terminals and agents open inside one." vertex="1"><mxGeometry x="40" y="30" width="1090" height="80" as="geometry"/></mxCell>
                <mxCell id="legend19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;• blue = shipped in this build&lt;br&gt;• grey dashed = planned&lt;br&gt;• red = a refusal" vertex="1"><mxGeometry x="1140" y="20" width="420" height="80" as="geometry"/></mxCell>
                <mxCell id="phone19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;Phone / browser&lt;/b&gt;&lt;br&gt;Machines tab: Add a computer (code + two commands), list online/offline, Terminal · Screen · Remove&lt;br&gt;Projects tab: clone a repo or add a folder, New terminal, Start agent&lt;br&gt;Terminals stream with ?machine=&amp;lt;name&amp;gt; for a machine's shell" vertex="1"><mxGeometry x="40" y="140" width="520" height="110" as="geometry"/></mxCell>
                <mxCell id="serve19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;dashed=0;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacing=10" value="&lt;b&gt;devcules serve&lt;/b&gt;" vertex="1"><mxGeometry x="40" y="290" width="1000" height="560" as="geometry"/></mxCell>
                <mxCell id="api19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;internal/api&lt;/b&gt;&lt;br&gt;POST /api/machines/enrol-code (session, CSRF, audit)&lt;br&gt;POST /api/machines/enrol (code + key + signature; no session, no Origin, 10/10 min per IP)&lt;br&gt;GET /api/machines (enrolled rows, online), DELETE /api/machines/{name} (revoke + kick)&lt;br&gt;/api/terminals?machine= · /api/projects · /api/projects/{id}/terminals · /api/agents {project}" vertex="1"><mxGeometry x="60" y="330" width="600" height="120" as="geometry"/></mxCell>
                <mxCell id="hub19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;link/hub&lt;/b&gt;&lt;br&gt;runner: Authorization Bearer &amp;lt;runner token&amp;gt;&lt;br&gt;machine: Authorization Machine → hello → &lt;b&gt;challenge {nonce}&lt;/b&gt; → challenge.answer {sig} → welcome&lt;br&gt;links keyed runner name | machine/&amp;lt;name&amp;gt; (no clash on one computer)" vertex="1"><mxGeometry x="60" y="480" width="600" height="100" as="geometry"/></mxCell>
                <mxCell id="relay19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;terminals/relay&lt;/b&gt; · &lt;b&gt;machines/relay&lt;/b&gt;&lt;br&gt;term.open {term, dir, project, clone} to a runner or machine address&lt;br&gt;mach.screen/input/tree/ground/verify (scale, per-type waits)" vertex="1"><mxGeometry x="60" y="610" width="600" height="80" as="geometry"/></mxCell>
                <mxCell id="store19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;store&lt;/b&gt; (SQLite)&lt;br&gt;enrol_codes (hash, 15 min, single use)&lt;br&gt;machines (name, pubkey, last_seen)&lt;br&gt;projects (0009: name, kind, target, dir, repo)" vertex="1"><mxGeometry x="700" y="330" width="320" height="120" as="geometry"/></mxCell>
                <mxCell id="svc19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;machines.Service&lt;/b&gt;&lt;br&gt;Redeem: proof over the code, claim then create (no double enrol)&lt;br&gt;VerifyMachine: ed25519 over the nonce, touch last_seen&lt;br&gt;Remove: delete the key" vertex="1"><mxGeometry x="700" y="480" width="320" height="120" as="geometry"/></mxCell>
                <mxCell id="refuse19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;refused&lt;/b&gt;&lt;br&gt;runner token claiming role machine (1008)&lt;br&gt;wrong key / unknown / silent machine (1008 machine auth failed)&lt;br&gt;enrol with an Origin header (403), reused code (400), taken name (409)" vertex="1"><mxGeometry x="700" y="630" width="320" height="110" as="geometry"/></mxCell>
                <mxCell id="runner19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;devcules runner&lt;/b&gt;&lt;br&gt;tmux sessions in the workspace; a project terminal starts in its dir, tagged @devcules_project; clone runs git clone -- &amp;lt;url&amp;gt; &amp;lt;dir&amp;gt; in the visible terminal" vertex="1"><mxGeometry x="40" y="890" width="480" height="100" as="geometry"/></mxCell>
                <mxCell id="machine19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;devcules machine&lt;/b&gt; (on your other computers)&lt;br&gt;enrol &amp;lt;code&amp;gt; [--name]: key in DATA_DIR/machine.key (0600), name + serve in machine.json&lt;br&gt;run: dials /link, signs the challenge, serves screen · input · tree · OCR · grounding and a tmux shell (DEVCULES_MACHINE_SHELL=off withholds it)" vertex="1"><mxGeometry x="560" y="890" width="480" height="120" as="geometry"/></mxCell>
                <mxCell id="later19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;later&lt;/b&gt;&lt;br&gt;macOS / Windows screen + input drivers (stubs today)&lt;br&gt;install script served by serve" vertex="1"><mxGeometry x="1080" y="890" width="300" height="80" as="geometry"/></mxCell>
                <mxCell id="e19a" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6C8EBF;endArrow=block" value="HTTPS, session" edge="1" source="phone19" target="api19"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e19b" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6C8EBF;endArrow=block" value="" edge="1" source="api19" target="store19"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e19c" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6C8EBF;endArrow=block" value="" edge="1" source="api19" target="relay19"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e19d" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6C8EBF;endArrow=block" value="VerifyMachine" edge="1" source="hub19" target="svc19"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e19e" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6C8EBF;endArrow=block" value="link (token)" edge="1" source="relay19" target="runner19"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e19f" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6C8EBF;endArrow=block" value="link (signed)" edge="1" source="relay19" target="machine19"><mxGeometry relative="1" as="geometry"/></mxCell>
            </root>
