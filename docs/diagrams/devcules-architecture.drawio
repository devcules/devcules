                <mxCell id="cfg-zone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;internal/config — config.Load()&lt;/b&gt;&lt;br&gt;env + *_FILE · validated at start · one error lists every problem" vertex="1">
