                    <mxGeometry height="110" width="350" x="500" y="890" as="geometry"/>
                </mxCell>
                <mxCell id="z3-guard" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11" value="&lt;b&gt;open refuses to guess&lt;/b&gt;&lt;br&gt;an edited applied migration names its file&lt;br&gt;a database newer than the binary asks for an upgrade — neither ever runs" vertex="1">
                    <mxGeometry height="110" width="350" x="900" y="890" as="geometry"/>
                </mxCell>
                <mxCell id="z3-lock" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11" value="&lt;b&gt;BEGIN IMMEDIATE per migration&lt;/b&gt;&lt;br&gt;racing openers take turns; the loser re-checks inside the lock and finds the work done&lt;br&gt;SQLITE_BUSY → bounded retry (5 s)" vertex="1">
