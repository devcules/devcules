                <mxCell id="a9-z-pty" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;4 · RUNNER SIDE&lt;/b&gt; — internal/terminals/pty: tmux is the source of truth" vertex="1">
                    <mxGeometry height="470" width="560" x="1150" y="484" as="geometry"/>
                </mxCell>
                <mxCell id="a9-p1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;tmux -L devcules&lt;/b&gt;&lt;br&gt;status off · history 10000&lt;br&gt;escape-time 0 · window-size latest" vertex="1">
                    <mxGeometry height="86" width="250" x="1180" y="552" as="geometry"/>
                </mxCell>
                <mxCell id="a9-p2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;attach per browser&lt;/b&gt;&lt;br&gt;creack/pty (MIT) · phone and&lt;br&gt;desktop share one terminal" vertex="1">
                    <mxGeometry height="86" width="230" x="1450" y="552" as="geometry"/>
                </mxCell>
                <mxCell id="a9-p3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;off the read loop&lt;/b&gt;&lt;br&gt;tmux calls in goroutines (≤ 4)&lt;br&gt;input via a 256-frame queue" vertex="1">
                    <mxGeometry height="86" width="250" x="1180" y="664" as="geometry"/>
                </mxCell>
                <mxCell id="a9-p4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;closing an attach&lt;/b&gt;&lt;br&gt;SIGHUP the client, then reap once&lt;br&gt;(no hang on a blocked PTY read)" vertex="1">
                    <mxGeometry height="86" width="230" x="1450" y="664" as="geometry"/>
                </mxCell>
                <mxCell id="a9-p5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;environment scrubbed&lt;/b&gt; — TERM, HOME, PATH, LANG, SHELL only: no DEVCULES_* reaches a shell" vertex="1">
