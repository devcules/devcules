                <mxCell id="a7-n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;fontColor=#555555;fontSize=11" value="&lt;b&gt;no service worker&lt;/b&gt;&lt;br&gt;the manifest makes it installable;&lt;br&gt;offline and push come with M3.2" vertex="1">
