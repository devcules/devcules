    <diagram id="arch16" name="Arch_16">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1750" pageHeight="1420" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t17" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#333333" value="&lt;b&gt;ARCH_16&lt;/b&gt; — Build 16 (M3.2): approvals and Web Push. Before a tool call an agent&#x27;s hook asks serve; the runner&#x27;s access mode and the critical rules decide allow, deny or ask. An ask notifies the phone and waits for Allow once or Deny." vertex="1">
                    <mxGeometry height="60" width="1090" x="40" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="legend17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;• blue = shipped in this build (M3.2)&lt;br&gt;• grey dashed = planned module (milestone tag)&lt;br&gt;• dashed + animated = a tool call on its way to the phone and back (plays in the draw.io app)&lt;br&gt;• red = a refusal, or a known limit" vertex="1">
                    <mxGeometry height="94" width="570" x="1140" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="a16-z1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;1 · THE AGENT ASKS&lt;/b&gt; — devcules hook, in the runner" vertex="1">
                    <mxGeometry height="330" width="820" x="40" y="118" as="geometry"/>
                </mxCell>
                <mxCell id="a16-1.1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;agent adapter&lt;/b&gt;&lt;br&gt;pipes each tool call&lt;br&gt;to devcules hook (M3.3)" vertex="1">
                    <mxGeometry height="86" width="260" x="70" y="186" as="geometry"/>
                </mxCell>
                <mxCell id="a16-1.2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;devcules hook&lt;/b&gt;&lt;br&gt;stdin {agent, tool, command}&lt;br&gt;exit 0 allow · 2 deny" vertex="1">
                    <mxGeometry height="86" width="240" x="350" y="186" as="geometry"/>
                </mxCell>
                <mxCell id="a16-1.3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;launch token&lt;/b&gt;&lt;br&gt;DEVCULES_LAUNCH_TOKEN&lt;br&gt;names the launch&#x27;s runner" vertex="1">
                    <mxGeometry height="86" width="220" x="610" y="186" as="geometry"/>
                </mxCell>
                <mxCell id="a16-1.4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;POST /hook/approvals&lt;/b&gt;&lt;br&gt;long poll ≤ 25 s&lt;br&gt;then GET …/{id} again" vertex="1">
                    <mxGeometry height="86" width="260" x="70" y="312" as="geometry"/>
                </mxCell>
                <mxCell id="a16-1.5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;serve restart&lt;/b&gt;&lt;br&gt;transport and 5xx retried&lt;br&gt;with backoff, up to 15 min" vertex="1">
                    <mxGeometry height="86" width="240" x="350" y="312" as="geometry"/>
                </mxCell>
                <mxCell id="a16-1.6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#B85450;dashed=1;fontColor=#555555;fontSize=11" value="&lt;b&gt;no / bad token&lt;/b&gt;&lt;br&gt;401 · the hook exits 1&lt;br&gt;adapters treat it as deny" vertex="1">
                    <mxGeometry height="86" width="220" x="610" y="312" as="geometry"/>
                </mxCell>
                <mxCell id="a16-z2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;2 · THE POLICY&lt;/b&gt; — internal/approvals" vertex="1">
