    <diagram id="arch3" name="Arch_3">
        <mxGraphModel dx="2562" dy="1310" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1340" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t4" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#333333" value="ARCH_3 — Build 3 (M0.3): the store — internal/store (the surface) · internal/store/sqlite (the backend) · storetest (the contract suite). No role opens it yet: serve wires it in M0.5." vertex="1">
                    <mxGeometry height="60" width="1150" x="40" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="legend4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;• blue = shipped in this build (M0.3)&lt;br&gt;• solid grey = static relation&lt;br&gt;• grey dashed ghost = later module&lt;br&gt;• green = refuses to guess, by design" vertex="1">
                    <mxGeometry height="120" width="330" x="1380" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="if-zone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;internal/store — the surface&lt;/b&gt;&lt;br&gt;lifecycle + repos, nothing else — the whole storage a role may touch" vertex="1">
                    <mxGeometry height="560" width="400" x="60" y="200" as="geometry"/>
                </mxCell>
                <mxCell id="st-store" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12" value="&lt;b&gt;Store&lt;/b&gt; — the whole surface a role needs&lt;br&gt;Ping · Close · SchemaVersion · Meta()&lt;br&gt;lifecycle plus repos, nothing else" vertex="1">
                    <mxGeometry height="90" width="360" x="80" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="st-meta" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;Meta() — MetaRepo&lt;/b&gt;&lt;br&gt;string key/value repo for installer-level state&lt;br&gt;(schema markers · bootstrap flags) · Get · Set · Delete&lt;br&gt;an empty key is rejected" vertex="1">
                    <mxGeometry height="110" width="360" x="80" y="420" as="geometry"/>
                </mxCell>
                <mxCell id="st-notfound" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;ErrNotFound — typed not-found&lt;/b&gt;&lt;br&gt;wrapped with the key name, matched with errors.Is —&lt;br&gt;callers never parse messages" vertex="1">
                    <mxGeometry height="90" width="360" x="80" y="560" as="geometry"/>
                </mxCell>
                <mxCell id="st-rule" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11" value="&lt;b&gt;how a repo grows&lt;/b&gt; (docs/store.md)&lt;br&gt;interface PR → one numbered migration → contract tests" vertex="1">
                    <mxGeometry height="80" width="360" x="80" y="670" as="geometry"/>
                </mxCell>
                <mxCell id="sqlite-zone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;internal/store/sqlite — the backend&lt;/b&gt;&lt;br&gt;the file · the pragmas · the migrations — database/sql only, no ORM, no cgo" vertex="1">
                    <mxGeometry height="560" width="640" x="500" y="200" as="geometry"/>
                </mxCell>
                <mxCell id="sq-open" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11" value="&lt;b&gt;Open(ctx, path)&lt;/b&gt;&lt;br&gt;the file lives at DATA_DIR/devcules.db&lt;br&gt;dir created 0700 · file 0600&lt;br&gt;a path, never a URL — nothing secret to log" vertex="1">
                    <mxGeometry height="130" width="280" x="520" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="sq-pragmas" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11" value="&lt;b&gt;pragmas ride in the DSN&lt;/b&gt;&lt;br&gt;busy_timeout first — WAL setup waits too&lt;br&gt;WAL · foreign_keys=ON · 5 s busy&lt;br&gt;every pooled connection, not just the first" vertex="1">
                    <mxGeometry height="130" width="280" x="840" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="sq-conn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11" value="&lt;b&gt;one connection&lt;/b&gt; — MaxOpenConns(1)&lt;br&gt;M0.3 serializes writers instead of&lt;br&gt;tuning a pool it cannot yet fill" vertex="1">
                    <mxGeometry height="90" width="280" x="520" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="sq-driver" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11" value="&lt;b&gt;pure Go&lt;/b&gt; — modernc.org/sqlite, no cgo&lt;br&gt;database/sql only · no ORM&lt;br&gt;the Postgres URL is not handled here" vertex="1">
                    <mxGeometry height="90" width="280" x="840" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="sq-meta" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;metaRepo on the meta table&lt;/b&gt;&lt;br&gt;Set upserts · Delete of a missing key: fine&lt;br&gt;Get on a missing key → ErrNotFound + the key&lt;br&gt;values never appear in errors" vertex="1">
                    <mxGeometry height="110" width="280" x="520" y="570" as="geometry"/>
                </mxCell>
                <mxCell id="sq-later" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;fontColor=#555555;fontSize=11" value="&lt;b&gt;not here, on purpose&lt;/b&gt;&lt;br&gt;Postgres wiring (DATABASE_URL) and every other repo — each lands as its own module with its migration + tests" vertex="1">
                    <mxGeometry height="110" width="280" x="840" y="570" as="geometry"/>
                </mxCell>
                <mxCell id="suite-zone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;internal/store/storetest — the contract suite&lt;/b&gt;&lt;br&gt;Run(t, newStore) wires one constructor — every backend, same behaviour" vertex="1">
                    <mxGeometry height="560" width="560" x="1180" y="200" as="geometry"/>
                </mxCell>
                <mxCell id="su-run" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12" value="&lt;b&gt;Run(t, newStore)&lt;/b&gt; — one constructor, the same behaviour everywhere:&lt;br&gt;fresh open migrates · reopen is a no-op that keeps data · Meta CRUD with a typed not-found&lt;br&gt;Ping before and after Close · concurrent use under -race · context cancellation honored" vertex="1">
                    <mxGeometry height="130" width="500" x="1200" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="su-fake" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;in-memory fake&lt;/b&gt;&lt;br&gt;the suite passes on a correct backend — its checks are not vacuous" vertex="1">
                    <mxGeometry height="110" width="240" x="1200" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="su-probe" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;broken-store probe&lt;/b&gt;&lt;br&gt;a child process proves the suite fails a broken store loudly" vertex="1">
                    <mxGeometry height="110" width="230" x="1470" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="su-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=10;fontColor=#333333" value="&lt;b&gt;Why this ships in build 3&lt;/b&gt; — every later module lands a repo on this surface; one shared suite proves the behaviour once (migrations · WAL · concurrency) instead of each module re-testing its backend." vertex="1">
                    <mxGeometry height="100" width="500" x="1200" y="590" as="geometry"/>
                </mxCell>
                <mxCell id="zoom3-zone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontSize=13;fontColor=#666666" value="&lt;b&gt;Zoom — one migration, file to recorded&lt;/b&gt; — and the ways Open refuses to guess" vertex="1">
                    <mxGeometry height="240" width="1630" x="60" y="800" as="geometry"/>
                </mxCell>
                <mxCell id="z3-files" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11" value="&lt;b&gt;migrations/*.sql — go:embed&lt;/b&gt;&lt;br&gt;NNNN_name.sql, version-sorted · a bad name or a duplicate version fails at open — a build bug, never silently skipped" vertex="1">
                    <mxGeometry height="110" width="350" x="100" y="890" as="geometry"/>
