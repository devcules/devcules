                <mxCell id="t3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#333333" value="ARCH_2 — Build 2 (M0.2): config + cmd/devcules subcommands — the binary builds and validates; it runs nothing yet (roles are stubs that report what they would start)" vertex="1">
