                <mxCell id="n-vault" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;fontColor=#555555;fontSize=11" value="&lt;b&gt;vault decode&lt;/b&gt; (M2)&lt;br&gt;the key bytes config holds" vertex="1">
