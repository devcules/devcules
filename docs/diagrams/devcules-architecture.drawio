                <mxCell id="a12-1.6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11" value="&lt;b&gt;overlaps&lt;/b&gt;&lt;br&gt;earliest, then longest span wins&lt;br&gt;one placeholder per stretch" vertex="1">
